{
  "name": "알람 지시서 평가셋",
  "version": "1.0",
  "created": "2026-10-30",
  "description": "알람마다 '어느 매뉴얼을 근거로 써야 하는가'를 미리 정해 둔 정답셋. expectedManual 이 null 이면 해당 알람을 다루는 매뉴얼이 없어 '매뉴얼 없음, 사람 확인 필요'로 답해야 하는 문항이다.",
  "fields": {
    "expectedManual": "근거로 써야 할 주 매뉴얼 id (없으면 null)",
    "expectedSections": "검색 상위 k 안에 들어와야 할 섹션 (주 매뉴얼 기준)",
    "expectLoto": "지시서에 잠금·표지(LOTO) 안내가 있어야 하는가",
    "note": "정답을 이렇게 정한 이유"
  },
  "cases": [
    {"id": "C01", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "vibration", "direction": "HIGH", "severity": "WARNING", "threshold": 4.5, "value": 5.2, "unit": "mm/s",
     "expectedManual": "MAN-MIX-VIB-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "진동 주의 구간(4.5~7.1)"},
    {"id": "C02", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "vibration", "direction": "HIGH", "severity": "CRITICAL", "threshold": 7.1, "value": 8.2, "unit": "mm/s",
     "expectedManual": "MAN-MIX-VIB-01", "expectedSections": ["가능 원인", "조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "위험 구간은 정지 후 LOTO"},
    {"id": "C03", "equipmentId": "MIXER-02", "equipmentType": "MIXER", "metric": "vibration", "direction": "HIGH", "severity": "CRITICAL", "threshold": 7.1, "value": 7.6, "unit": "mm/s",
     "expectedManual": "MAN-MIX-VIB-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "다른 배합기도 같은 매뉴얼"},
    {"id": "C04", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "vibration", "direction": "HIGH", "severity": "WARNING", "threshold": 4.5, "value": 4.7, "unit": "mm/s",
     "expectedManual": "MAN-MIX-VIB-01", "expectedSections": ["점검 절차"], "expectLoto": false, "note": "기준을 막 넘은 서서히 오르는 경우. 정기 점검 기준(MAN-MIX-PM-01)이 함께 검색되면 좋다"},
    {"id": "C05", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "current", "direction": "HIGH", "severity": "WARNING", "threshold": 18, "value": 19.3, "unit": "A",
     "expectedManual": "MAN-MIX-CUR-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "과부하 경고(18A)"},
    {"id": "C06", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "current", "direction": "HIGH", "severity": "CRITICAL", "threshold": 22, "value": 23.5, "unit": "A",
     "expectedManual": "MAN-MIX-CUR-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "트립 위험(22A), 정지 후 LOTO"},
    {"id": "C07", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "temperature", "direction": "LOW", "severity": "WARNING", "threshold": 68, "value": 66.5, "unit": "C", "batchPhase": "EMULSIFYING",
     "expectedManual": "MAN-MIX-TEMP-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "유화 단계 68C 아래"},
    {"id": "C08", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "temperature", "direction": "LOW", "severity": "CRITICAL", "threshold": 62, "value": 60.8, "unit": "C", "batchPhase": "EMULSIFYING",
     "expectedManual": "MAN-MIX-TEMP-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "유화 단계 62C 아래, 스팀 밸브 정비 시 LOTO"},
    {"id": "C09", "equipmentId": "TANK-02", "equipmentType": "RAW_TANK", "metric": "temperature", "direction": "HIGH", "severity": "WARNING", "threshold": 45, "value": 47.2, "unit": "C",
     "expectedManual": "MAN-TANK-TEMP-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "오일상 탱크 40C 기준 초과"},
    {"id": "C10", "equipmentId": "TANK-02", "equipmentType": "RAW_TANK", "metric": "temperature", "direction": "HIGH", "severity": "CRITICAL", "threshold": 55, "value": 57.0, "unit": "C",
     "expectedManual": "MAN-TANK-TEMP-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "밸브 정비 시 LOTO"},
    {"id": "C11", "equipmentId": "TANK-01", "equipmentType": "RAW_TANK", "metric": "level", "direction": "LOW", "severity": "WARNING", "threshold": 30, "value": 27.5, "unit": "%",
     "expectedManual": "MAN-TANK-LVL-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "보충 필요"},
    {"id": "C12", "equipmentId": "TANK-01", "equipmentType": "RAW_TANK", "metric": "level", "direction": "LOW", "severity": "CRITICAL", "threshold": 15, "value": 12.0, "unit": "%",
     "expectedManual": "MAN-TANK-LVL-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": false, "note": "펌프 공회전 위험. 이 매뉴얼은 LOTO를 요구하지 않는다"},
    {"id": "C13", "equipmentId": "TANK-01", "equipmentType": "RAW_TANK", "metric": "level", "direction": "LOW", "severity": "WARNING", "threshold": 30, "value": 29.0, "unit": "%", "batchPhase": "CHARGING",
     "expectedManual": "MAN-TANK-LVL-01", "expectedSections": ["점검 절차"], "expectLoto": false, "note": "원료 투입 중 레벨 저하도 같은 매뉴얼"},
    {"id": "C14", "equipmentId": "FILLER-01", "equipmentType": "FILLER", "metric": "speed", "direction": "LOW", "severity": "WARNING", "threshold": 100, "value": 94, "unit": "bpm",
     "expectedManual": "MAN-FIL-SPD-01", "expectedSections": ["가능 원인", "조치 - 경고(WARNING)"], "expectLoto": false, "note": "생산성 저하 경고"},
    {"id": "C15", "equipmentId": "FILLER-01", "equipmentType": "FILLER", "metric": "speed", "direction": "LOW", "severity": "CRITICAL", "threshold": 80, "value": 72, "unit": "bpm",
     "expectedManual": "MAN-FIL-SPD-01", "expectedSections": ["조치 - 위험(CRITICAL)"], "expectLoto": true, "note": "스타휠에 손 넣기 전 LOTO"},

    {"id": "N01", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "temperature", "direction": "HIGH", "severity": "WARNING", "threshold": 80, "value": 83.0, "unit": "C", "batchPhase": "HEATING",
     "expectedManual": null, "expectedSections": [], "expectLoto": false, "note": "배합기 온도 매뉴얼은 '저하'만 다룬다. 과열 조치는 근거가 없다"},
    {"id": "N02", "equipmentId": "TANK-01", "equipmentType": "RAW_TANK", "metric": "level", "direction": "HIGH", "severity": "WARNING", "threshold": 90, "value": 93.0, "unit": "%",
     "expectedManual": null, "expectedSections": [], "expectLoto": false, "note": "넘침(고레벨) 매뉴얼 없음. 저레벨 매뉴얼로 답하면 반대 조치가 나간다"},
    {"id": "N03", "equipmentId": "TANK-01", "equipmentType": "RAW_TANK", "metric": "temperature", "direction": "LOW", "severity": "WARNING", "threshold": 18, "value": 15.5, "unit": "C",
     "expectedManual": null, "expectedSections": [], "expectLoto": false, "note": "탱크 온도 매뉴얼은 '과열'만 다룬다"},
    {"id": "N04", "equipmentId": "FILLER-01", "equipmentType": "FILLER", "metric": "speed", "direction": "HIGH", "severity": "WARNING", "threshold": 130, "value": 136, "unit": "bpm",
     "expectedManual": null, "expectedSections": [], "expectLoto": false, "note": "충진기 과속 매뉴얼 없음"},
    {"id": "N05", "equipmentId": "MIXER-01", "equipmentType": "MIXER", "metric": "current", "direction": "LOW", "severity": "WARNING", "threshold": 6, "value": 4.2, "unit": "A",
     "expectedManual": null, "expectedSections": [], "expectLoto": false, "note": "저전류(무부하·커플링 이탈 의심) 매뉴얼 없음"}
  ]
}
